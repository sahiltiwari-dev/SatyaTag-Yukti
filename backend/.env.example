# ============================================================
# SATYATAG backend environment (copy to .env and fill values)
# NEVER commit the real .env file. Secrets stay server-side.
# ============================================================

# --- Application ---
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173

# --- PostgreSQL (DATABASE_URL format) ---
# postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://satyatag:satyatag-dev-password-2026@127.0.0.1:5433/satyatag

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=SATYATAG <no-reply@satyatag.local>
# Set to "console" to print emails to the server log in development
EMAIL_MODE=console

# --- OTP policy ---
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Storage ---
UPLOAD_DIR=uploads