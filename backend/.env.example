# SATYATAG Backend — Environment Configuration Template
# Copy to backend/.env and fill in real values.
# Never commit backend/.env to version control.

# Application
APP_NAME=SATYATAG API
APP_VERSION=0.1.0
APP_ENV=development

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-key-change-me

# PostgreSQL — local Docker setup (see scripts/start-db.ps1)
DATABASE_URL=postgresql+psycopg://satyatag:satyatag@127.0.0.1:5433/satyatag

# CORS — must match the Vite dev server or production frontend URL exactly
FRONTEND_ORIGIN=http://localhost:5173

# Email transport
# console: prints OTPs/reset links to server log (dev only)
# resend: sends real emails via Resend API
EMAIL_MODE=console

# Required when EMAIL_MODE=resend
RESEND_API_KEY=
EMAIL_FROM=SATYATAG <no-reply@yourdomain.com>

# OTP policy
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Password reset
PASSWORD_RESET_EXPIRY_HOURS=1

# Storage (relative to backend/ directory)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=20971520
